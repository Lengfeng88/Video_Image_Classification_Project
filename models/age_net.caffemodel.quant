digraph G {
	"cluster_4" [label="{conv1\nConvolution\nkernel_size : 7\lstride : 4\l | relu1\nReLU\noutput: 1 x 96 x 56 x 56\lOCV/CPU\n }" fillcolor="#ffffb3" style=filled shape=record]
